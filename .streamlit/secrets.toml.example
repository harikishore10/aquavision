# AquaVision Streamlit Secrets Configuration Template
# In local development: Copy this file to .streamlit/secrets.toml and insert your real key.
# In Streamlit Community Cloud: Paste these key-value pairs into the app Settings -> Secrets dashboard.

# Google Gemini API key for Intelligent Species Assessment
GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: Specify vision-capable model (e.g. "gemini-1.5-flash" or "gemini-2.0-flash")
# If left commented or blank, the default model is used.
# GEMINI_MODEL = "gemini-1.5-flash"

# Optional: External backend URL if running in Backend API mode (defaults to local services)
# AQUAVISION_BACKEND_URL = "http://127.0.0.1:8000"
