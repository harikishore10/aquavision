# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Streamlit secrets (allow config.toml for dark theme)
.streamlit/secrets.toml

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/

# Large ML model binaries (trained via python train.py)
models/*.joblib
models/*.pt
models/*.onnx
!models/evaluation_report.json